# Copia para .env e ajusta. NUNCA versionar o .env real.

# --- Base de dados (usado pelo docker-compose e pela API em Docker) ---
POSTGRES_USER=terminal
POSTGRES_PASSWORD=troca-esta-password
POSTGRES_DB=terminal

# Em Docker a API usa esta ligacao. Localmente (sem Docker) deixa DATABASE_URL
# vazio para cair no SQLite ./api/data/terminal.db automaticamente.
# DATABASE_URL=postgresql+psycopg://terminal:troca-esta-password@postgres:5432/terminal

# --- Ingestao ---
MARKET_INTERVAL_SECONDS=300
NEWS_INTERVAL_SECONDS=300

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- IA (multi-provedor com fallback automatico) ---
# "auto" tenta pela ordem: anthropic -> groq -> openai -> gemini.
# Basta configurar UMA. Se uma falhar (ex: sem creditos), passa a seguinte.
AI_PROVIDER=auto
AI_MAX_TOKENS=4096

# Anthropic (Claude) - pago (precisa de creditos de API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq - GRATIS, rapido, sem cartao. Chave: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI ou compativel (ex: OpenRouter: base=https://openrouter.ai/api/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini - free tier. Chave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
